# @vercel/analytics déclare un peer optionnel sur vue-router ^4 (pour son
# intégration Vue générique) — on utilise ici les entrées `/nuxt/runtime`, qui
# ne dépendent pas de cette intégration, avec vue-router 5 (Nuxt 4). npm refuse
# ce conflit par défaut ; legacy-peer-deps le laisse passer (sans danger : ce
# peer n'est jamais réellement importé).
legacy-peer-deps=true
